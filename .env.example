# Plex Dashboard Environment Variables
#
# NOTE FOR CLAUDE: Use APP_USER credentials to log into the app and test features.
# Jellyfin/Jellyseerr settings are already configured via the Settings page in the app.

# App Credentials (for logging into localhost)
APP_USER_EMAIL=test_email@email.com
APP_USER_PASSWORD=test_password

# Database (SQLite by default)
DATABASE_URL=sqlite:///./plex_dashboard.db

# In production, these are injected from GitHub Secrets
# DISABLE_SIGNUPS=false  # Set to true to block new user registrations
# REDIS_PASSWORD=long-random-hex  # Required in prod; dev falls back to "devpassword"
# SMTP2GO_API_KEY=api-xxxxxxxxxxxxx
# SMTP_FROM_EMAIL=noreply@mediajanitor.com
# FRONTEND_URL=https://mediajanitor.com
# SECRET_KEY=your-secret-key-change-in-production
# SLACK_WEBHOOK_NEW_USERS=https://hooks.slack.com/...
# SLACK_WEBHOOK_SYNC_FAILURES=https://hooks.slack.com/...
# Hub App alerts: after each sync of HUB_ALERT_USER_EMAIL's account, send the
# issue counts to the Hub's Attention. Off unless all three are set.
# HUB_BASE_URL=https://hub.jimmydore.fr
# HUB_APP_ALERT_TOKEN=token-from-the-hub-HUB_APP_TOKENS-mediajanitor-entry
# HUB_ALERT_USER_EMAIL=you@example.com
